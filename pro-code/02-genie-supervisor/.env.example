# Used by live model/Genie requests; offline tests do not need authentication.
DATABRICKS_CONFIG_PROFILE=DEFAULT
DEMO_ACTOR_ID=agent
# Genie IDs belong in agent.toml, updated by the CLI commands in README.md.
# To use existing managed stores from a direct local server (not agentbricks dev):
# AGENT_SESSION_STORE=<existing-session-store-name>
# AGENT_MEMORY_STORE=<existing-memory-store-id>
# Single-user/team demo identity is server-owned; input.actor is ignored.
# Production must derive identity and session ownership from authentication.
