# Choose a profile; no workspace is preselected.
DATABRICKS_CONFIG_PROFILE=<profile>
# Single-user sandbox identity, controlled by the server.
DEMO_ACTOR_ID=agent
MEMORY_WRITE_MODE=tools
MEMORY_AUTO_RECALL=false
# Existing stores, used by `uv run start-server`, not CLI dev's local mode.
# AGENT_SESSION_STORE=hello-memory-demo-sessions
# AGENT_MEMORY_STORE=<actual-memory-store-id-returned-by-create>
# Optional remote tracing with direct server startup.
# MLFLOW_TRACKING_URI=databricks
# MLFLOW_EXPERIMENT_NAME=/Shared/agentbricks_traces/hello-memory-demo
